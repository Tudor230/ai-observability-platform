# Secrets for the single-machine deployment (docker-compose.local.yml).
# Copy to `.env` (gitignored) and fill in real values; generate with:
#   openssl rand -hex 32

# Service key for x-admin-key (admin-scoped API calls). Required.
AIOBS_ADMIN_API_KEY=

# HS256 signing key for dashboard session cookies. Required.
AIOBS_JWT_SECRET=

# Bootstrap admin password. Applied only when the admin account is first
# created; rotate an existing one via POST /api/v1/users/{id}/reset-password
# (see ops/README.md). Required.
AIOBS_ADMIN_PASSWORD=

# Optional bootstrap admin email (default: admin@local).
AIOBS_ADMIN_EMAIL=
